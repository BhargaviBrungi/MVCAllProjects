<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My MVC All Projects</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Login","Login","Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("New User Registration", "UserRegister", "UserRegistration", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Hotel Registration", "HotelRegister", "HotelRegistration", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("ShareMarketGraph", "Index", "ShareMarketGraph", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("QRScanner", "CreateQRCode", "QRScanner", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Captcha", "Index", "Captcha", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Calendar", "Index", "Calendar", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Calculator", "Index", "Calculator", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Weather", "Weather", "Weather", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Project</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
