@model MVCAllProjects.Models.Hotel
<!DOCTYPE html>
<html>
<head>
    <style>
        #form {
            padding-top: 30px;
            background-color: lightseagreen;
            border-radius: 8px;
        }
        #user {
            text-align: center;
            color: firebrick;
        }
        #tcenter {
            margin: 0 auto;
            border: 2px solid purple;
            height: 300px;
            width: 600px;
            padding-top: 20px;
            padding-left: 70px;
            background-color: lightblue;
            color: black;
        }
        .myspace {
            padding: 10px;
        }
       #btn {
            margin-left: 180px;
            color: darkblue;
            background-color: lightgreen;
            padding: 5px;
            padding-left: 8px;
            border-radius: 8px;
            font-size: large;
        }
        #msg {
            color: black;
            text-align:center;
        }
        #Main {
            color: purple;
            margin-left: 250px;
        }
        .field-validation-error{
            color:red;
        }
    </style>
    <meta name="viewport" content="width=device-width" />
    <title>HotelRegister</title>
</head>
<body id="form">
    <div>
        @using (Html.BeginForm("HotelRegister", "HotelRegistration", FormMethod.Post))
        {
            <div id="tcenter">
                <h2 id="user">Hotel Registration Form</h2>
                <div class="myspace">
                    @Html.LabelFor(model => model.Username)
                    @Html.TextBoxFor(model => model.Username)
                    @Html.ValidationMessageFor(model => model.Username)
                </div>
                <div class="myspace">
                    @Html.LabelFor(model => model.RoomType)
                    @Html.RadioButtonFor(model => model.RoomType, "Delux") Delux
                    @Html.RadioButtonFor(model => model.RoomType, "Ordinary") Ordinary
                    @Html.ValidationMessageFor(model => model.RoomType)
                </div>
                <div class="myspace">
                    @Html.LabelFor(model => model.Amenities)
                    @foreach (var item in TempData["SelectAmenities"] as List<string>)
                    {
                        @Html.CheckBox(item, false, new { id = item }) @item
                    }
                    @Html.ValidationMessageFor(model => model.Amenities)
                </div>
                <div id="button">
                    <input type="submit" value="Register" id="btn" />
                </div>
                </div>
                }
            </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="msg">@TempData["SuccessMessage"]</div>
        }
    <div id="Main">
        <a href="@Url.Action("Index","HotelRegistration")" class="btn btn-primary">Index Page</a>
    </div>
</body>
</html>

